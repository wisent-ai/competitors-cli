{
  "name": "@wisent-ai/competitors-cli",
  "version": "0.1.0",
  "description": "Evidence-first competitor discovery, comparison, and market research CLI",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisent-ai/competitors-cli.git"
  },
  "bin": {
